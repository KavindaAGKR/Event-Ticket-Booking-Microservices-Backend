generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Payment {
  id         String   @id @default(uuid())
  bookingId  Int
  customerId String
  amount     Float
  status     String
  createdAt  DateTime @default(now())
}
