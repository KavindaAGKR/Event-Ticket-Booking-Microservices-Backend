    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${env.GIT_BRANCH}",
                    url: "${env.GIT_REPO}",
                    credentialsId: 'b1bac234-98e7-43a8-8404-a7dfe41a3b10'
            }
        }

        stage('Build') {
            steps {
                echo 'Build step here'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing...'
            }
        }
    }
}
